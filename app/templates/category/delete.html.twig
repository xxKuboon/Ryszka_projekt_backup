{% extends 'base.html.twig' %}

{% block title %}
    Usuwanie kategorii
{% endblock %}

{% block body %}
    <h1>Usuwanie kategorii: {{ category.title }} </h1>
    <div class="form-group row float-sm-right">
        <input type="submit" value="{{ 'Usuń kategorię'|trans }}" class="btn btn-primary" />
    </div>
    <div class="form-group row float-sm-left">
        <a href="{{ url('category_index') }}" class="btn btn-link">
            {{ 'Powrót do listy'|trans }}
        </a>
    </div>
    {{ form_end(form) }}

{% endblock %}
